diff --git a/app/src/main/cpp/native_bridge.cpp b/app/src/main/cpp/native_bridge.cpp
index 5d34c3a..3a3c95b 100644
--- a/app/src/main/cpp/native_bridge.cpp
+++ b/app/src/main/cpp/native_bridge.cpp
@@ -127,8 +127,14 @@ Java_io_github_jqssun_airplay_bridge_NativeBridge_nativeStart(
     unsigned short port = (unsigned short)(requestedPort > 0 ? requestedPort : 7000);
     int ret = raop_start_httpd(ctx->raop, &port);
     if (ret < 0) {
-        LOGE("raop_start_httpd failed: %d", ret);
-        return -1;
+        /* MX: 指定の番号が他のアプリ(OTTO本体のAirReceiver等)で使用中なら、空き番号に自動で逃がす */
+        LOGE("raop_start_httpd failed on port %d: %d, retrying with a free port", (int)port, ret);
+        port = 0;
+        ret = raop_start_httpd(ctx->raop, &port);
+        if (ret < 0) {
+            LOGE("raop_start_httpd failed: %d", ret);
+            return -1;
+        }
     }
     /* raop_start_httpd doesn't record the bound port; without this the hls
        proxy urls are built with port 0 */
