<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 自分が入れたアプリ(と自分自身)を、確認画面なしで更新する(Android 12 以上)。
         これが無いと毎回確認画面が出て、Duo Cruise(ホーム)の後ろに隠れて止まっていた(2026-10-27) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 指示 updater:packages(入っているアプリの一覧を読むだけ)のため -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 指示 updater:multiplay-log(機器の CarPlay の部品の記録を読むだけ)のため。adb で pm grant して使う -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <!-- 自作アプリ(同じ署名)どうしの記録・指示のやり取り。同じ署名のアプリだけが持てる -->
    <permission
        android:name="com.yuki.duocruise.permission.LOG"
        android:label="Duo Cruise の記録"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.yuki.duocruise.permission.LOG" />
    <queries>
        <package android:name="com.yuki.duocruise.updater" />
        <package android:name="com.yuki.duocruise.main" />
    </queries>
    <application
        android:name=".App"
        android:label="Duo Cruise Market"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".InstallReceiver" android:exported="false" />
        <!-- 自作アプリからの記録(送れるのは権限 LOG を持つ同じ署名のアプリだけ) -->
        <receiver
            android:name=".LogReceiver"
            android:exported="true"
            android:permission="com.yuki.duocruise.permission.LOG">
            <intent-filter>
                <action android:name="com.yuki.duocruise.updater.LOG" />
            </intent-filter>
        </receiver>
        <!-- 今すぐ確認(新しい版ができた合図を受けた Duo Cruise から。送れるのは同じ署名のアプリだけ) -->
        <receiver
            android:name=".CheckReceiver"
            android:exported="true"
            android:permission="com.yuki.duocruise.permission.LOG">
            <intent-filter>
                <action android:name="com.yuki.duocruise.updater.CHECK" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".CheckJobService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".ConfirmClickService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/confirm_service" />
        </service>
    </application>
</manifest>
