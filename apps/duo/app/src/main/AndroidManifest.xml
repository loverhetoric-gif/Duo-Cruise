<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- TV 版 YouTube(D の tv/DialServer): iPhone から自動で見つけてもらう(DIAL/SSDP) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 記録の送信(宣言は更新アプリ。署名が同じアプリだけ) -->
    <uses-permission android:name="com.yuki.duocruise.permission.LOG" />
    <!-- 「OTTO のホームを開く」でホームアプリを探すため -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Duo"
        android:hardwareAccelerated="true"
        android:supportsRtl="false">
        <!-- 本体: 1つの画面の中に左右2つの枠(CarPlay / TV 版 YouTube)と操作盤 -->
        <activity
            android:name=".DuoActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|keyboard|navigation|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ホームアプリの候補になる(既定にするかは、本人が Android の設定「ホームアプリ」で選ぶ。自動では選ばない) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- ホーム・タスクの受け取り(Duo Cruise が前面のときだけ) -->
        <service
            android:name=".PaneService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pane_service" />
        </service>
        <!-- 記録シートの「指示」の受け口(送れるのは同じ署名の更新アプリだけ) -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:permission="com.yuki.duocruise.permission.LOG">
            <intent-filter>
                <action android:name="com.yuki.duocruise.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
