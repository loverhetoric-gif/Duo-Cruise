<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 自作アプリ(同じ署名)どうしの記録・指示のやり取り。更新アプリと同じ定義(どちらが先に入っても使える) -->
    <permission
        android:name="com.yuki.duocruise.permission.LOG"
        android:label="Duo Cruise の記録"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.yuki.duocruise.permission.LOG" />
    <queries>
        <package android:name="com.yuki.duocruise.updater" />
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 記録シートの指示(更新アプリから。送れるのは同じ署名のアプリだけ) -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:permission="com.yuki.duocruise.permission.LOG">
            <intent-filter>
                <action android:name="com.yuki.duocruise.COMMAND" />
            </intent-filter>
        </receiver>
        <service
            android:name=".KeyRecorderService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>
    </application>
</manifest>
