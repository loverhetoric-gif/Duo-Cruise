          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network access is required (Settings → Duo Slate → Local Network)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a la red local (Ajustes → Duo Slate → Red local)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au réseau local requis (Réglages → Duo Slate → Réseau local)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario l’accesso alla rete locale (Impostazioni → Duo Slate → Rete locale)"
